<script>
  // Вибір типу сесії → посилання кнопки запису
  const book = document.querySelector<HTMLElement>('[data-book]');
  const link = book?.querySelector<HTMLAnchorElement>('[data-book-link]');
  book?.addEventListener('change', (e) => { const t = e.target as HTMLInputElement; if (t.name === 'session' && link) link.href = t.dataset.href!; });
  const checked = book?.querySelector<HTMLInputElement>('input[name=session]:checked');
  if (checked && link) link.href = checked.dataset.href!;

  // «Про мене»: довгий текст згортаємо, кнопка розгортає
  const bio = document.querySelector<HTMLElement>('[data-bio]');
  const more = document.querySelector<HTMLButtonElement>('[data-bio-more]');
  if (bio && more && bio.scrollHeight > 300) {
    bio.classList.add('is-clamped'); more.hidden = false;
    more.addEventListener('click', () => {
      const open = bio.classList.toggle('is-clamped') === false;
      more.setAttribute('aria-expanded', String(open));
      more.querySelector('span')!.textContent = open ? 'Згорнути' : 'Читати повністю';
    });
  }

  // Мобільна прилипла панель запису: ховається, коли видно картку запису або футер
  const bar = document.querySelector<HTMLElement>('[data-book-bar]');
  if (bar && book) {
    const seen = new Map<Element, boolean>();
    const sync = () => { const v = ![...seen.values()].some(Boolean); bar.classList.toggle('is-visible', v); bar.setAttribute('aria-hidden', String(!v)); bar.querySelector('a')?.setAttribute('tabindex', v ? '0' : '-1'); };
    const io = new IntersectionObserver((es) => { es.forEach((e) => seen.set(e.target, e.isIntersecting)); sync(); });
    [book, document.querySelector('footer'), document.querySelector('.pre')].forEach((el) => el && io.observe(el));
  }
</script>
