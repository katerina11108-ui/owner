---
// Блог (/blog): рекомендована стаття, фільтр за рубриками, сітка карток, підписка. Дані — src/data/blog.ts.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FilterChips from '../../components/FilterChips.astro';
import Newsletter from '../../components/Newsletter.astro';
import CTAPrefooter from '../../components/CTAPrefooter.astro';
import Button from '../../components/Button.astro';
import { sorted, categories, articleMeta } from '../../data/blog';
const featured = sorted.find((a) => a.featured) ?? sorted[0];
const rest = sorted.filter((a) => a !== featured);
const used = categories.filter((c) => rest.some((a) => a.category === c));
---
<Base title="Блог" description="Статті фахівців центру Neoiatria про психічне здоров’я, терапію і самодопомогу — зрозуміло, чесно, без лякалок.">
  <PageHero crumbs={[{ label: 'Блог' }]} title="Про психічне здоров’я без зайвих слів" lead="Статті від практикуючих терапевтів — зрозуміло, чесно, без лякалок." />
  <div class="container wrap">
    {featured && (
      <article class="featured">
        <div class="cover">{featured.cover && <img src={featured.cover} alt="" fetchpriority="high" />}<span class="cat">{featured.category}</span></div>
        <div class="tx">
          <p class="t-body-s w-500 c-tertiary">Рекомендуємо почати з цього</p>
          <h2 class="t-h2"><a href={`/blog/${featured.slug}`}>{featured.title}</a></h2>
          <p class="t-body-l c-secondary">{featured.excerpt}</p>
          <p class="t-body-s c-tertiary">{articleMeta(featured, true)}</p>
          <div><Button href={`/blog/${featured.slug}`} tabindex="-1" aria-hidden="true">Читати статтю</Button></div>
        </div>
      </article>
    )}
    <section class="all" aria-label="Усі статті">
      <FilterChips target="articles" label="Рубрики" options={used.map((c) => ({ value: c, label: c }))} />
      <div class="grid" id="articles">{rest.map((a) => <ArticleCard a={a} />)}</div>
    </section>
    <Newsletter />
  </div>
  <CTAPrefooter />
</Base>
<style>
  .wrap{display:flex;flex-direction:column;gap:var(--space-56);padding-top:var(--space-64)}
  .featured{position:relative;display:flex;gap:var(--space-48);align-items:center}
  .cover{position:relative;width:620px;max-width:52%;aspect-ratio:620/380;flex:none;border-radius:var(--radius-2xl);overflow:hidden;background:var(--bg-placeholder);padding:var(--space-16)}
  .cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .cat{position:relative;display:inline-block;padding:var(--space-4) var(--space-12);border-radius:var(--radius-full);background:var(--bg-surface);font-size:12px;line-height:16px;font-weight:500}
  .tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:var(--space-16)}
  .tx h2 a::after{content:'';position:absolute;inset:0}
  .featured:hover h2 a{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:2px}
  .all{display:flex;flex-direction:column;gap:var(--space-28)}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-48) var(--space-24)}
  @media (max-width:1023px){
    .featured{flex-direction:column;align-items:stretch;gap:var(--space-24)}
    .cover{width:100%;max-width:none}
    .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media (max-width:767px){
    .wrap{gap:var(--space-40);padding-top:var(--space-24)}
    .tx{gap:var(--space-12)}
    .all{gap:var(--space-20)}
    .grid{grid-template-columns:minmax(0,1fr);gap:var(--space-32)}
  }
</style>
