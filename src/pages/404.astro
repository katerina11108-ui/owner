---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CTAPrefooter from '../components/CTAPrefooter.astro';
const popular = [['Тривога','/directions/anxiety'],['Депресія','/directions/depression'],['Панічні атаки','/directions/anxiety'],['Вигорання','/directions/burnout'],['Стосунки','/directions/relationships'],['Консультація психіатра','/directions/psychiatric-consultation'],['Підбір за 5 питань','/quiz'],['Блог','/blog'],['Події','/events']];
---
<Base title="Сторінку не знайдено" sticky={false}>
  <section class="nf on-brand">
    <div class="container inner">
      <p class="t-body-s c-on-brand-muted">Помилка 404</p>
      <h1 class="t-h1 c-on-brand">Такої сторінки немає</h1>
      <p class="t-body-l c-on-brand-2 lead">Можливо, посилання застаріло або в адресі помилка. Нижче — три шляхи, якими сюди зазвичай приходять.</p>
      <div class="ctas"><Button href="/specialists" variant="light" size="l">Знайти спеціаліста</Button><Button href="/" variant="outline-on-brand" size="l">На головну</Button></div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="t-h3 c-brand">Найчастіше шукають</h2>
      <ul class="pop">{popular.map(([l,h]) => <li><a href={h}>{l}</a></li>)}</ul>
    </div>
  </section>
  <CTAPrefooter />
</Base>
<style>
  .nf{background:var(--bg-brand);border-radius:0 0 var(--radius-2xl) var(--radius-2xl)}
  .inner{padding-block:var(--space-96);display:flex;flex-direction:column;gap:var(--space-20)}
  .lead{max-width:600px}
  .ctas{display:flex;gap:var(--space-12);margin-top:var(--space-12);flex-wrap:wrap}
  .pop{display:flex;flex-wrap:wrap;gap:var(--space-8);margin-top:var(--space-24)}
  .pop a{display:inline-block;padding:8px 16px;border-radius:var(--radius-full);background:var(--bg-muted);font-size:14px;line-height:20px;font-weight:500;color:var(--text-primary)}
  .pop a:hover{background:var(--bg-panel)}
  @media (max-width:767px){.inner{padding-block:var(--space-24) var(--space-32);gap:var(--space-16)}.ctas{flex-direction:column}.ctas :global(.btn){width:100%}}
</style>
