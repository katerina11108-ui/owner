---
import Button from './Button.astro';
interface Props { href?: string; label?: string }
const { href = '/specialists', label = 'Знайти спеціаліста' } = Astro.props;
---
<div class="sticky" data-sticky-cta aria-hidden="true"><Button href={href} variant="primary" size="l" block tabindex="-1">{label}</Button></div>
<style>
  .sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:var(--bg-surface);border-top:1px solid var(--border-subtle);box-shadow:0 -4px 16px rgb(18 45 34 / .08);transform:translateY(110%);transition:transform .2s ease-out}
  .sticky.is-visible{transform:none}
  @media (min-width:768px){.sticky{display:none}}
</style>
<script>
  // З'являється, коли кнопки першого екрана ([data-hero-ctas]) пішли з екрана; ховається біля футера.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('[data-hero-ctas]');
  const footer = document.querySelector('footer');
  if (bar) {
    let heroGone = !hero, footerIn = false;
    const sync = () => { const v = heroGone && !footerIn; bar.classList.toggle('is-visible', v); bar.setAttribute('aria-hidden', String(!v)); bar.querySelector('a')?.setAttribute('tabindex', v ? '0' : '-1'); };
    if (hero) new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(hero);
    if (footer) new IntersectionObserver(([e]) => { footerIn = e.isIntersecting; sync(); }).observe(footer);
    sync();
  }
</script>
