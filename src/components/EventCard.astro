---
import Icon from './Icon.astro';
import Button from './Button.astro';
interface Props { e: { day: string; month: string; kind: string; title: string; hosts: string; where: { icon: string; text: string }; price: string; cta: string; free?: boolean } }
const { e } = Astro.props;
---
<article class="card">
  <div class="top">
    <div class="row">
      <span class="date"><b>{e.day}</b><span>{e.month}</span></span>
      <span class="kind">{e.kind}</span>
    </div>
    <h3 class="t-h5 w-600 c-primary">{e.title}</h3>
    <ul class="details">
      <li><Icon name="user" size={16} /><span>{e.hosts}</span></li>
      <li><Icon name={e.where.icon} size={16} /><span>{e.where.text}</span></li>
      <li><Icon name="payment" size={16} /><span>{e.price}</span></li>
    </ul>
  </div>
  <Button href="#" variant={e.free ? 'secondary' : 'outline'} block class={e.free ? 'muted' : ''}>{e.cta}</Button>
</article>
<style>
  .card{background:var(--bg-surface);border-radius:var(--radius-xl);padding:var(--space-24);display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-24);height:100%}
  .top{display:flex;flex-direction:column;gap:var(--space-20)}
  .row{display:flex;justify-content:space-between;align-items:flex-start}
  .date{width:64px;height:64px;border-radius:var(--radius-lg);background:var(--bg-brand);display:flex;flex-direction:column;align-items:center;justify-content:center}
  .date b{font-size:24px;line-height:32px;font-weight:600;letter-spacing:-.01em;color:var(--text-on-brand)}
  .date span{font-size:12px;line-height:16px;font-weight:500;color:var(--text-on-brand-secondary)}
  .kind{padding:4px 12px;border-radius:var(--radius-full);background:var(--bg-panel);font-size:12px;line-height:16px;font-weight:500;color:var(--text-brand)}
  .details{display:flex;flex-direction:column;gap:var(--space-8)}
  .details li{display:flex;align-items:center;gap:var(--space-8);font-size:14px;line-height:20px;font-weight:500;color:var(--text-primary)}
  .card :global(.muted){background:var(--bg-muted);color:var(--text-primary)}
  .card :global(.btn--outline){color:var(--text-primary)}
</style>
