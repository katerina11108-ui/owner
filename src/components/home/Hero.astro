---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { settings, uah } from '../../data/site';
// Дані з Altegio (annotation): кількість фахівців із вільними слотами цього тижня + найближчий слот. Немає даних → картку не показуємо.
interface Props { availability?: { count: number; nearest: string } | null }
const { availability = { count: 9, nearest: 'сьогодні о 18:00' } } = Astro.props;
---
<section class="hero on-brand">
  <div class="container inner">
    <div class="text">
      <div class="who">
        <p class="eyebrow">Центр психіатрії та практичної психології</p>
        <h1 class="t-display">У кожного своя причина тут опинитись</h1>
        <p class="lead">«Мені важко». «Я втратив опору». «У мене все добре, але чомусь мені погано». Цього вже достатньо, щоб прийти.</p>
      </div>
      <p class="diff">Платите за кожну сесію окремо, без пакетів. Психіатр і терапевт — в одній команді.</p>
      <div class="ctas" data-hero-ctas>
        <Button href="/specialists" variant="light" size="l">Знайти спеціаліста</Button>
        <Button href="/quiz" variant="outline-on-brand" size="l">Не знаю, до кого звернутися</Button>
      </div>
    </div>
    <div class="photo">
      <img src="/images/hero-session.jpg" alt="Сесія в кабінеті центру: дві жінки розмовляють на дивані" width="600" height="584" loading="eager" fetchpriority="high" />
      <ul class="badges">
        <li>Сесія від {uah(settings.minPrice)}</li>
        <li>Ліцензія МОЗ</li>
      </ul>
      {availability && availability.count > 0 && (
        <div class="avail">
          <p class="t-caption w-500 c-tertiary">Вільні години цього тижня</p>
          <p class="t-body-l w-600">У {availability.count} фахівців. Найближча — {availability.nearest}</p>
          <a class="link t-body-s" href="/specialists?sort=nearest"><span>Подивитись розклад</span><Icon name="arrow-right" size={15} /></a>
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .hero{background:var(--bg-brand);border-radius:0 0 var(--radius-2xl) var(--radius-2xl);color:var(--text-on-brand)}
  .inner{display:flex;gap:var(--space-40);align-items:center;padding-block:var(--space-88)}
  .text{flex:1;display:flex;flex-direction:column;gap:var(--space-20)}
  .who{display:flex;flex-direction:column;gap:var(--space-20)}
  .eyebrow{font-weight:500;color:var(--text-on-brand-accent)}
  .lead{font-size:20px;line-height:28px;letter-spacing:-.01em;color:var(--text-on-brand-secondary);max-width:580px}
  .diff{font-size:18px;line-height:28px;font-weight:500;color:var(--text-on-brand-accent)}
  .ctas{display:flex;gap:var(--space-12);flex-wrap:wrap;margin-top:var(--space-20)}
  .photo{flex:1;position:relative;align-self:stretch;min-height:584px;border-radius:var(--radius-2xl);overflow:hidden;background:var(--bg-brand-hover)}
  .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;color:transparent}
  .badges{position:absolute;top:var(--space-20);left:var(--space-20);right:var(--space-20);display:flex;flex-wrap:wrap;gap:var(--space-8)}
  .badges li{height:40px;display:inline-flex;align-items:center;padding-inline:var(--space-16);border-radius:var(--radius-full);background:var(--bg-crisis);color:var(--text-primary);font-weight:500}
  .avail{position:absolute;left:24px;bottom:24px;width:320px;max-width:calc(100% - 48px);background:var(--bg-surface);border-radius:var(--radius-xl);padding:var(--space-20);display:flex;flex-direction:column;gap:var(--space-4);color:var(--text-primary)}
  @media (max-width:1023px){
    .hero{border-radius:0 0 var(--radius-xl) var(--radius-xl)}
    .inner{flex-direction:column;align-items:stretch;padding-block:var(--space-24) var(--space-32);gap:var(--space-16)}
    .text{gap:var(--space-16)}
    .who{gap:var(--space-16)}
    .lead{font-size:16px;line-height:24px}
    .ctas{order:2;flex-direction:column;margin-top:var(--space-8)}
    .ctas :global(.btn){width:100%}
    .diff{order:3;font-size:14px;line-height:20px;font-weight:400;text-align:center;color:var(--text-on-brand-muted)}
    .photo{min-height:0;display:flex;flex-direction:column;gap:var(--space-16);background:none;overflow:visible;border-radius:0}
    .badges{position:static;order:-1}
    .badges li{height:36px;font-size:14px;line-height:20px;background:var(--bg-brand-hover);color:var(--text-on-brand)}
    .photo img{position:relative;height:420px;border-radius:var(--radius-2xl);background:var(--bg-brand-hover)}
    .avail{left:16px;right:16px;bottom:16px;width:auto;max-width:none;padding:var(--space-16)}
    .avail :global(.t-body-l){font-size:16px;line-height:24px}
  }
</style>
