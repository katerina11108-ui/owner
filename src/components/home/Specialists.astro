---
import SpecialistCard from '../SpecialistCard.astro';
import Button from '../Button.astro';
import { specialists } from '../../data/specialists';
import { ua } from '../../data/site';
const featured = specialists.slice(0, 2);
const rest = specialists.length - featured.length;
---
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="t-h2 c-brand">Людина, з якою буде не страшно говорити</h2>
      <p class="c-tertiary">Видно, з чим працює, якою мовою, скільки коштує і коли вільна — до того, як писати.</p>
    </div>
    <div class="grid m-scroll" style="--m-card:320px">
      {featured.map((sp) => <SpecialistCard sp={sp} />)}
      <div class="more on-brand">
        <div class="mt"><h3 class="t-h3 c-on-brand">Ще {rest} {ua(rest)} в каталозі</h3><p class="c-on-brand-2">Фільтри за запитом, форматом, мовою, ціною і тим, з ким працює фахівець.</p></div>
        <Button href="/specialists" variant="light" block>Усі фахівці</Button>
      </div>
    </div>
  </div>
</section>
<style>
  .grid{display:grid;grid-template-columns:438px 438px 1fr;gap:var(--space-24)}
  .more{background:var(--bg-brand);border-radius:var(--radius-xl);padding:var(--space-28);display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-24)}
  .mt{display:flex;flex-direction:column;gap:var(--space-12)}
  @media (max-width:1279px){.grid{grid-template-columns:1fr 1fr}.more{grid-column:1/-1}}
  @media (max-width:767px){.grid{grid-template-columns:1fr}}
</style>
