---
interface Props { size?: number; name?: boolean; sub?: boolean; tone?: 'on-brand' | 'default' }
const { size = 62, name = true, sub = false, tone = 'on-brand' } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="Neoiatria — на головну">
  <span class="mark" style={`width:${size}px;height:${size}px`}><img src="/images/logo.svg" alt="" width={size} height={size} /></span>
  {name && (
    <span class="names">
      <span class="name">Neoiatria</span>
      {sub && <span class="sub">Центр психіатрії та практичної психології</span>}
    </span>
  )}
</a>
<style>
  .logo{display:inline-flex;align-items:center;gap:var(--space-16)}
  .mark{flex:none;border-radius:50%;background:var(--bg-panel);overflow:hidden}
  .mark img{width:100%;height:100%}
  .names{display:flex;flex-direction:column}
  .name{font-size:20px;line-height:28px;font-weight:600;letter-spacing:-.01em}
  .sub{font-size:14px;line-height:20px;color:var(--text-on-brand-muted)}
  .logo--on-brand .name{color:var(--text-on-brand)}
  .logo--default .name{color:var(--text-primary)}
</style>
